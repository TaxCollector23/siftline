# Firebase Admin credentials for the hosted API.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
CUTDEX_KEY_PEPPER=

# Firebase web configuration for Google sign-in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local API testing only; comma-separated complete Cutdex keys.
CUTDEX_DEV_API_KEYS=

# Optional CLI endpoint override when the hosted Cutdex URL changes.
CUTDEX_API_URL=https://siftline-omega.vercel.app
