# Optional hosted account/quota mode. Local Cutdex mode needs none of these.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
SIFTLINE_KEY_PEPPER=

# Firebase web configuration for Google sign-in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local API testing only; comma-separated complete Siftline keys.
SIFTLINE_DEV_API_KEYS=

# Opt in to the hosted optimizer. Leave unset for local-first, plan-safe mode.
CUTDEX_USE_HOSTED_API=0
