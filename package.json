{
  "name": "cutdex",
  "version": "0.3.0",
  "description": "Conservative read optimization for Codex tool calls.",
  "type": "module",
  "bin": { "cutdex": "dist/cli/index.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "dev": "concurrently \"pnpm --dir apps/web dev\" \"pnpm benchmark:watch\"",
    "build": "pnpm build:core && pnpm build:cli && pnpm --dir apps/web build",
    "build:core": "tsup packages/core/src/index.ts --format esm --dts --out-dir dist/core",
    "build:cli": "tsup --config packages/cli/tsup.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint packages apps api scripts --ext .ts,.tsx",
    "test": "vitest run",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:watch": "tsx scripts/benchmark.ts --watch",
    "prepublishOnly": "pnpm build:core && pnpm build:cli",
    "start": "node dist/cli/index.js start"
  },
  "workspaces": ["apps/*", "packages/*"],
  "packageManager": "pnpm@11.6.0",
  "engines": { "node": ">=20" },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.20.0", "@types/node": "^22.13.0", "@types/react": "^19.0.8", "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.4.1", "concurrently": "^9.1.2", "eslint": "^9.20.1", "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18", "jsdom": "^26.0.0", "react": "^19.0.0", "react-dom": "^19.0.0",
    "tsx": "^4.19.3", "tsup": "^8.3.6", "typescript": "^5.7.3", "typescript-eslint": "^8.24.0", "vite": "^6.1.0", "vitest": "^3.0.5"
  }
}
